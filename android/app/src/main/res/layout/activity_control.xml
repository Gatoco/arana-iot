<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/telemetry"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/telemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="@string/no_telemetry" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/manual_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/manual_mode" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/gait"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <RadioGroup
            android:id="@+id/gait_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gait_tetrapod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/tetrapod" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gait_wave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/wave" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/gait_rest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/rest" />
        </RadioGroup>

        <TextView
            android:id="@+id/speed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/speed"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.slider.Slider
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:stepSize="0.05"
            android:value="0.6"
            android:valueFrom="0"
            android:valueTo="1" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:rowCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dpad_forward"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_margin="4dp"
                android:text="@string/forward"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dpad_left"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_margin="4dp"
                android:text="@string/left"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_margin="4dp"
                android:backgroundTint="#C62828"
                android:text="@string/stop"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dpad_right"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_margin="4dp"
                android:text="@string/right"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dpad_back"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_margin="4dp"
                android:text="@string/back"
                android:textSize="12sp" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
